NODE_ENV=development
HOST=0.0.0.0
SERVER_PORT=3000
LOG_LEVEL=info

POSTGRES_DB=cleanflow
POSTGRES_USER=cleanflow
POSTGRES_PASSWORD=change-me-before-use
DATABASE_URL=postgresql://cleanflow:change-me-before-use@localhost:5432/cleanflow
DATABASE_SSL=false
DB_POOL_MIN=0
DB_POOL_MAX=10

ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_NAME=cleanflow_refresh
AUTH_COOKIE_SECURE=false
FILE_STORAGE_PATH=uploads
FILE_MAX_SIZE_MB=10
FILE_MAX_PER_ITEM=10

VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:3000
PUBLIC_PORT=8080
