NODE_ENV=development
HOST=0.0.0.0
SERVER_PORT=3000
LOG_LEVEL=info

POSTGRES_DB=cleanflow
POSTGRES_USER=cleanflow
POSTGRES_PASSWORD=change-me-before-use
DATABASE_URL=postgresql://cleanflow:change-me-before-use@localhost:5432/cleanflow
DATABASE_SSL=false
DB_POOL_MIN=0
DB_POOL_MAX=10

ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
AUTH_COOKIE_NAME=cleanflow_refresh
# Локально (клиент и сервер на одном origin через vite proxy): secure=false, samesite=strict.
# В проде, когда клиент и сервер живут на разных доменах: secure=true (обязательно
# при samesite=none) и samesite=none — иначе браузер не пришлёт refresh-cookie.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=strict
# Список разрешённых origin'ов клиента через запятую, например
# https://cleanflow.pages.dev. Нужен только в проде — без него сервер не
# отправляет CORS-заголовки и кросс-доменные запросы будут блокироваться браузером.
CORS_ORIGIN=
FILE_STORAGE_PATH=uploads
FILE_MAX_SIZE_MB=10
FILE_MAX_PER_ITEM=10

VITE_API_URL=/api/v1
VITE_API_PROXY_TARGET=http://localhost:3000
PUBLIC_PORT=8080
